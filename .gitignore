.local/
node_modules/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.tmp/
tmp/
dist/

# Entity GPG keyring — private keys, never commit
keyring/

# Flight plans — ephemeral dispatch artifacts (durable record is commit trailer)
flight-plans/

# Claude Code harness artifacts (regenerated per session)
.claude.json
.claude/
mcp-needs-auth-cache.json
archive/sessions/

# Runtime state
var/

# opencode TUI session state
tui.json
tooltips/

# Private keys — NEVER in git
id/ed25519
id/ecdsa
id/rsa
id/dsa

# Credentials and secrets
.credentials
.env.local
.env.*.local
.env.secret*

# Stale harness session dump — never commit
.context

# Agent logs — regenerable
logs/

# Runtime caches
__pycache__/
.pytest_cache/
.venv/
build/

# ── Runtime artifacts — VESTA-SPEC-145 ──────────────────────────────────────

# streams/ — trigger output, log files, event captures; fully regenerable
streams/

# qc/raw/ — auto-generated QC captures before deliberate review
qc/raw/

# .local/ — machine-local ephemera (socket files, PID files, temp state)
.local/

# node_modules/ (if present at entity root)
node_modules/

# SPEC-175: per-device private key material — never commit
id/devices/*/leaf.private.asc
id/devices/*/device.key

# SPEC-175: entity.public.asc is committed (sovereign-certified public identity)
!id/entity.public.asc
!id/entity.fingerprint
!id/migrated-at
!id/archive/**


